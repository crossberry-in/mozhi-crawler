# ============================================================
# Mozhi Crawler & Spider Demo & Showcase — mozhi run examples/demo.mz
# 100% Native Pure Mozhi
# ============================================================

import crawler from "../src/mod.mz"

echo("================================================================")
echo("          MOZHI CRAWLER & MULTI-AGENT RESEARCH ENGINE v1.3.0 DEMO                ")
echo("================================================================")

# 1. URL Parsing, Normalization & Origin Check
echo("\n--- [Demo 1] URL Normalization & Origin Verification ---")
let parsed = crawler.parse_url("http://127.0.0.1:8089/products/../docs/./install?v=1#readme")
echo("Hostname: " + parsed.hostname)
echo("Path:     " + parsed.path)
echo("Normalized: " + crawler.normalize_url("http://127.0.0.1:8089/products/../docs/./install?v=1#readme"))
echo("Same origin check: " + string(crawler.same_origin("http://127.0.0.1:8089/a", "http://127.0.0.1:8089/b")))

# 2. Live Fetch & Persistent Storage (save_db=true)
echo("\n--- [Demo 2] Advanced Web Spider (Live Fetch & Cache) ---")
let spider_res = crawler.spider({
    url: "http://127.0.0.1:8089/",
    live_fetch: true,
    save_db: true,
    cache_dir: ".crawler_cache",
    max_pages: 5,
    max_depth: 2,
    same_domain: true,
    max_total_requests: 15,
    allow_private_ips: true
})

echo("Spider Success: " + string(spider_res.ok))
echo("Pages Crawled:  " + string(spider_res.pages.len()))
echo("Total Requests: " + string(spider_res.stats.total_requests))
echo("Cache Hits:     " + string(spider_res.stats.cache_hits))
echo("Stopped Reason: " + spider_res.stopped_reason)

# 3. Offline Reading from Cache (live_fetch=false)
echo("\n--- [Demo 3] Offline Mode Reading (Zero Network Calls) ---")
let offline_res = crawler.spider({
    url: "http://127.0.0.1:8089/",
    offline: true,
    cache_dir: ".crawler_cache",
    max_pages: 3,
    allow_private_ips: true
})
echo("Offline Ok:       " + string(offline_res.ok))
echo("Offline Pages:    " + string(offline_res.pages.len()))
echo("Network Requests: " + string(offline_res.stats.total_requests) + " (must be 0)")
echo("Cache Hits:       " + string(offline_res.stats.cache_hits))

# 4. Link Graph & Analysis
echo("\n--- [Demo 4] Link Graph & Website Analysis ---")
let stats = crawler.spider_stats(spider_res)
echo("Discovered Links: " + string(stats.total_links_discovered))
echo("Internal Targets: " + string(stats.total_internal_links))
echo("External Targets: " + string(stats.total_external_links))

let outgoing_seed = crawler.get_outgoing_links(spider_res, "http://127.0.0.1:8089/")
echo("Outgoing links from Seed: " + string(outgoing_seed.len()))

let incoming_about = crawler.get_incoming_links(spider_res, "http://127.0.0.1:8089/about")
echo("Incoming links to /about: " + string(incoming_about.len()))

let duplicates = crawler.find_duplicate_content(spider_res)
echo("Duplicate content groups: " + string(duplicates.len()))

let broken = crawler.find_broken_links(spider_res)
echo("Confirmed broken links:   " + string(broken.len()))

# Export graph
crawler.export_graph_json(spider_res, "crawled_graph.json")
crawler.export_graph_csv(spider_res, "crawled_graph.csv")
echo("Exported link graph to crawled_graph.json & crawled_graph.csv")

# 5. Declarative Schema Extraction on E-Commerce Products
echo("\n--- [Demo 5] Declarative Schema Extraction ---")
let product_page = crawler.scrape("http://127.0.0.1:8089/products")
let product_schema = {
    "catalog_title": "header h1",
    "products": {
        "selector": "article.product-item",
        "multiple": true,
        "fields": {
            "id": { "attribute": "data-id" },
            "name": "h2.prod-title",
            "price": "span.prod-price",
            "buy_url": { "selector": "a.buy", "attribute": "href" }
        }
    }
}
let catalog = crawler.extract(product_page.doc, product_schema)
echo("Catalog: " + catalog.catalog_title)
for p in catalog.products {
    echo("  - [" + p.id + "] " + p.name + " (" + p.price + ") -> " + p.buy_url)
}

# 6. Categorized Terminal Tables
echo("\n--- [Demo 6] Categorized Terminal Tables ---")
let media_page = crawler.scrape("http://127.0.0.1:8089/media-showcase")
crawler.print_tables(media_page)

# 7. Multi-Agent LLM Research Engine (BlockRun Provider)
echo("\n--- [Demo 7] Complete Multi-Agent LLM Research Engine ---")
let research_result = crawler.research({
    query: "What products and developer gear does Mozhi offer and what are their prices?",
    url: "http://127.0.0.1:8089/products",
    provider_config: {
        default_provider: "blockrun",
        free_only: true,
        providers: [
            {
                id: "blockrun",
                name: "BlockRun",
                base_url: "http://127.0.0.1:8089/blockrun/v1",
                model_discovery: true,
                enabled: true
            }
        ]
    },
    max_pages: 3,
    save_cache: true,
    cache_dir: ".crawler_cache"
})

echo("Research Completed: " + string(research_result.ok))
echo("LLM Research Answer:\n" + research_result.answer)
echo("Discovered Sources: " + string(research_result.sources.len()))
echo("Verified Findings:  " + string(research_result.findings.len()))
echo("Agents Execution Trace:")
for a in research_result.agents {
    echo("  - " + a.name + ": " + a.status)
}

# Print categorized research tables
crawler.print_research_tables(research_result)

echo("\n================================================================")
echo("               DEMO FINISHED SUCCESSFULLY                       ")
echo("================================================================")
