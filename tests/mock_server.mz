app.get("/wiki/Data", fn(req, res) {
    let html = "<!doctype html><html lang=\"en\"><head>"
        + "<title>Data - Wikipedia</title>"
        + "<meta name=\"description\" content=\"Data is a collection of discrete values that convey information, describing quantity, quality, fact, statistics, or other basic units of meaning.\">"
        + "<meta name=\"keywords\" content=\"data, information, statistics, computing, knowledge\">"
        + "<meta name=\"author\" content=\"Wikipedia contributors\">"
        + "<meta property=\"og:title\" content=\"Data - Wikipedia\">"
        + "<meta property=\"og:image\" content=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/DIKW_Pyramid.svg/437px-DIKW_Pyramid.svg.png\">"
        + "<link rel=\"stylesheet\" href=\"/css/wikipedia.css\">"
        + "<link rel=\"icon\" href=\"/favicon.ico\">"
        + "<link rel=\"canonical\" href=\"https://en.wikipedia.org/wiki/Data\">"
        + "<script src=\"/js/wiki.js\"></script>"
        + "</head><body>"
        + "<header><h1>Data</h1><p class=\"lead\">From Wikipedia, the free encyclopedia</p></header>"
        + "<article>"
        + "<p>Data is a collection of discrete values that convey information, describing quantity, quality, fact, statistics, or other basic units of meaning.</p>"
        + "<p>A datum is an individual value in a collection of data. Data is usually organized into structures such as tables that provide additional context.</p>"
        + "<section id=\"etymology\">"
        + "<h2>Etymology and terminology</h2>"
        + "<p>The Latin word data is the plural of datum, '(something) given', which is the neuter past participle of the verb dare, 'to give'.</p>"
        + "<p>In English, the word data has been used as a plural noun since the 17th century, though it is now widely treated as a singular mass noun.</p>"
        + "</section>"
        + "<section id=\"meaning\">"
        + "<h2>Meaning</h2>"
        + "<p>Data, information, knowledge, and wisdom are closely related concepts in the DIKW pyramid.</p>"
        + "<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/06/DIKW_Pyramid.svg/437px-DIKW_Pyramid.svg.png\" alt=\"DIKW Pyramid illustrating relationships among data, information, knowledge, and wisdom\" width=\"437\" height=\"455\">"
        + "<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/77/Computer_tape.jpg/800px-Computer_tape.jpg\" alt=\"Magnetic tape data storage reel\" width=\"800\" height=\"533\">"
        + "<img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Hollerith_punched_card.jpg/800px-Hollerith_punched_card.jpg\" alt=\"Hollerith punched card data format\" width=\"800\" height=\"350\">"
        + "</section>"
        + "<section id=\"sources\">"
        + "<h2>Data sources</h2>"
        + "<p>Gathering data can be accomplished through primary sources such as scientific experiments, sensor networks, surveys, and administrative records.</p>"
        + "<p>Synthetic data is generated algorithmically when real-world datasets are scarce, proprietary, or constrained by privacy regulations.</p>"
        + "</section>"
        + "<section id=\"documents\">"
        + "<h2>Data documents</h2>"
        + "<p>Whenever data needs to be registered, it exists in the form of documents, repositories, or serialized archives.</p>"
        + "<ul>"
        + "<li><a href=\"/files/joint-doctrine-intelligence-data.pdf\">Joint Publication 2-0: Data and Intelligence (PDF)</a></li>"
        + "<li><a href=\"/files/world-bank-data-standards.pdf\">World Bank Open Data Standards (PDF)</a></li>"
        + "<li><a href=\"/files/open-datasets-catalog.csv\">Global Scientific Datasets Catalog (CSV)</a></li>"
        + "<li><a href=\"/files/data-dictionary-template.zip\">Data Architecture Dictionary Template (ZIP)</a></li>"
        + "</ul>"
        + "</section>"
        + "<section id=\"links\">"
        + "<h2>See also</h2>"
        + "<ul>"
        + "<li><a href=\"/wiki/Information\">Information</a></li>"
        + "<li><a href=\"/wiki/Knowledge\">Knowledge</a></li>"
        + "<li><a href=\"/wiki/Statistics\">Statistics</a></li>"
        + "<li><a href=\"/wiki/Big_data\">Big data</a></li>"
        + "<li><a href=\"/wiki/Database\">Database</a></li>"
        + "<li><a href=\"https://en.wiktionary.org/wiki/data\">Wiktionary: data definition</a></li>"
        + "<li><a href=\"https://commons.wikimedia.org/wiki/Category:Data\">Wikimedia Commons Data Media</a></li>"
        + "<li><a href=\"https://www.wikidata.org/wiki/Q42848\">Wikidata Entity Q42848</a></li>"
        + "</ul>"
        + "</section>"
        + "</article>"
        + "<footer><p>Text is available under the Creative Commons Attribution-ShareAlike License.</p></footer>"
        + "</body></html>"
    return res.html(html)
})

