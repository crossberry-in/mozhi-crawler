# ============================================================
# LLM Provider Mock Endpoints (BlockRun & Custom OpenAI Endpoints)
# ============================================================

# Model catalog for BlockRun
app.get("/blockrun/v1/models", fn(req, res) {
    let raw = fs.read("/home/user/blockrun_compact.json")
    let catalog = json.parse(raw)
    return res.json(catalog)
})

# Chat completions for BlockRun
app.post("/blockrun/v1/chat/completions", fn(req, res) {
    let req_data = json.parse(req.body)
    let requested_model = "unknown"
    if req_data.has("model") {
        requested_model = req_data.model
    }

    # Extract user message to provide context-aware response
    let user_prompt = ""
    if req_data.has("messages") {
        for msg in req_data.messages {
            if msg.has("role") and msg.role == "user" {
                if typeof(msg.content) == "string" {
                    user_prompt = msg.content
                }
            }
        }
    }

    # Generate grounded response based on user prompt
    let reply_content = "This is a simulated LLM completion from BlockRun."
    if user_prompt.contains("Mozhi") or user_prompt.contains("Compiler") or user_prompt.contains("Keyboard") {
        reply_content = "Based on the verified Mozhi catalog documentation, Mozhi Compiler Pro costs $99.00 and is an ahead-of-time compilation suite. Mozhi Mechanical Keyboard is available for $149.00, and the Mozhi Cotton Hoodie is priced at $45.00."
    } else if user_prompt.contains("Data") or user_prompt.contains("datum") {
        reply_content = "According to the source documentation, data is a collection of discrete values conveying information, describing quantity, quality, statistics, or facts. The singular form is datum, derived from the Latin word meaning 'something given'."
    } else if user_prompt.contains("plan") or user_prompt.contains("Plan") {
        reply_content = "{\"facts_to_establish\":[\"Product availability\",\"Pricing information\"],\"search_terms\":[\"products\",\"compiler\",\"keyboard\"],\"suggested_paths\":[\"/products\",\"/docs\"],\"completion_criteria\":\"Identify core products and pricing\"}"
    }

    return res.json({
        id: "chatcmpl-blockrun-mock-" + string(int(time())),
        object: "chat.completion",
        created: int(time()),
        model: requested_model,
        choices: [
            {
                index: 0,
                message: {
                    role: "assistant",
                    content: reply_content
                },
                finish_reason: "stop"
            }
        ],
        usage: {
            prompt_tokens: 45,
            completion_tokens: 65,
            total_tokens: 110
        }
    })
})

# Custom Provider Models
app.get("/custom/v1/models", fn(req, res) {
    return res.json({
        object: "list",
        data: [
            {
                id: "custom/llama-3.3-70b-instruct",
                name: "Custom Llama 3.3 70B",
                billing_mode: "free",
                categories: ["chat", "reasoning", "coding"],
                context_window: 128000,
                pricing: { input: 0, output: 0 }
            },
            {
                id: "custom/vision-pro-3b",
                name: "Custom Vision Pro 3B",
                billing_mode: "free",
                categories: ["chat", "vision"],
                context_window: 64000,
                pricing: { input: 0, output: 0 }
            }
        ]
    })
})

# Custom Provider Completions
app.post("/custom/v1/chat/completions", fn(req, res) {
    let req_data = json.parse(req.body)
    let model = "custom/llama-3.3-70b-instruct"
    if req_data.has("model") {
        model = req_data.model
    }
    return res.json({
        id: "chatcmpl-custom-" + string(int(time())),
        object: "chat.completion",
        created: int(time()),
        model: model,
        choices: [
            {
                index: 0,
                message: {
                    role: "assistant",
                    content: "Response from Custom LLM Provider."
                },
                finish_reason: "stop"
            }
        ],
        usage: { prompt_tokens: 20, completion_tokens: 10, total_tokens: 30 }
    })
})

# Error simulation endpoints for testing fallback and retry mechanisms
app.post("/error/rate-limit/chat/completions", fn(req, res) {
    res.status(429)
    res.header("Retry-After", "1")
    return res.json({
        error: {
            message: "Rate limit reached for requests",
            type: "requests_rate_limit",
            code: 429
        }
    })
})

app.post("/error/server-error/chat/completions", fn(req, res) {
    res.status(503)
    return res.json({
        error: {
            message: "Model backend temporarily unavailable",
            type: "service_unavailable",
            code: 503
        }
    })
})

app.post("/error/unauthorized/chat/completions", fn(req, res) {
    res.status(401)
    return res.json({
        error: {
            message: "Invalid API key provided",
            type: "invalid_request_error",
            code: "invalid_api_key"
        }
    })
})

echo("Mock Site & LLM Server listening on http://127.0.0.1:8089 ...")
app.listen("127.0.0.1", 8089)
