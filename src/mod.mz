# ------------------------------------------------------------
# Section 1: URL Normalization & Resolution
# ------------------------------------------------------------

fn clean_fragment(url) {
    if url == null {
        return ""
    }
    let hash_idx = index(url, "#")
    if hash_idx != -1 {
        return url.slice(0, hash_idx)
    }
    return url
}

fn parse_url(raw_url) {
    let result = {
        valid: false,
        protocol: "",
        scheme: "",
        host: "",
        hostname: "",
        port: "",
        path: "/",
        query: "",
        fragment: "",
        full: ""
    }
    if raw_url == null {
        return result
    }

    let working = raw_url.trim()
    let frag_idx = index(working, "#")
    if frag_idx != -1 {
        result.fragment = working.slice(frag_idx + 1, working.len())
        working = working.slice(0, frag_idx)
    }

    let q_idx = index(working, "?")
    if q_idx != -1 {
        result.query = working.slice(q_idx + 1, working.len())
        working = working.slice(0, q_idx)
    }

    let proto = ""
    let rest = ""

    if working.starts_with("http://") {
        proto = "http"
        rest = working.slice(7, working.len())
    } else if working.starts_with("https://") {
        proto = "https"
        rest = working.slice(8, working.len())
    } else {
        return result
    }

    result.protocol = proto
    result.scheme = proto

    let slash_idx = index(rest, "/")
    let host_part = rest
    if slash_idx != -1 {
        host_part = rest.slice(0, slash_idx)
        result.path = rest.slice(slash_idx, rest.len())
    } else {
        result.path = "/"
    }

    result.host = host_part
    let colon_idx = index(host_part, ":")
    if colon_idx != -1 {
        result.hostname = host_part.slice(0, colon_idx).lower()
        result.port = host_part.slice(colon_idx + 1, host_part.len())
    } else {
        result.hostname = host_part.lower()
        result.port = ""
    }

    result.valid = true
    let port_str = ""
    if result.port.len() > 0 {
        if not ((proto == "http" and result.port == "80") or (proto == "https" and result.port == "443")) {
            port_str = ":" + result.port
        }
    }
    result.full = proto + "://" + result.hostname + port_str + result.path
    return result
}

fn normalize_path(path) {
    if path == null or path == "" or path == "/" {
        return "/"
    }
    let has_leading = path.starts_with("/")
    let has_trailing = path.ends_with("/") and path.len() > 1

    let segments = path.split("/")
    let stack = []

    for seg in segments {
        if seg == "" or seg == "." {
            # skip current directory or empty
        } else if seg == ".." {
            if stack.len() > 0 {
                stack.pop()
            }
        } else {
            stack.push(seg)
        }
    }

    let res = join(stack, "/")
    if has_leading {
        res = "/" + res
    }
    if has_trailing and not res.ends_with("/") {
        res = res + "/"
    }
    if res == "" {
        res = "/"
    }
    return res
}

fn normalize_url(url) {
    let p = parse_url(url)
    if not p.valid {
        return url
    }
    let norm_p = normalize_path(p.path)
    let port_str = ""
    if p.port.len() > 0 {
        if not ((p.protocol == "http" and p.port == "80") or (p.protocol == "https" and p.port == "443")) {
            port_str = ":" + p.port
        }
    }
    let q_str = ""
    if p.query.len() > 0 {
        q_str = "?" + p.query
    }
    return p.protocol + "://" + p.hostname + port_str + norm_p + q_str
}

fn same_host(url1, url2) {
    if url1 == null or url2 == null {
        return false
    }
    let p1 = parse_url(url1)
    let p2 = parse_url(url2)
    if not p1.valid or not p2.valid {
        return false
    }
    return p1.host.lower() == p2.host.lower()
}

fn resolve_url(base_url, href) {
    if href == null {
        return null
    }
    let trimmed = clean_fragment(href).trim()
    if trimmed.len() == 0 {
        return null
    }

    if trimmed.starts_with("#") or
       trimmed.starts_with("javascript:") or
       trimmed.starts_with("mailto:") or
       trimmed.starts_with("tel:") or
       trimmed.starts_with("data:") {
        return null
    }

    if trimmed.starts_with("http://") or trimmed.starts_with("https://") {
        let p = parse_url(trimmed)
        if p.valid {
            return normalize_url(trimmed)
        }
        return null
    }

    let base = parse_url(base_url)
    if not base.valid {
        return null
    }

    let port_str = ""
    if base.port.len() > 0 {
        if not ((base.protocol == "http" and base.port == "80") or (base.protocol == "https" and base.port == "443")) {
            port_str = ":" + base.port
        }
    }
    let origin = base.protocol + "://" + base.hostname + port_str

    if trimmed.starts_with("//") {
        return normalize_url(base.protocol + ":" + trimmed)
    }

    if trimmed.starts_with("/") {
        return normalize_url(origin + trimmed)
    }

    if trimmed.starts_with("?") {
        return normalize_url(origin + base.path + trimmed)
    }

    # Relative path resolution
    let last_slash = -1
    let i = base.path.len() - 1
    while i >= 0 {
        if base.path.slice(i, i + 1) == "/" {
            last_slash = i
            break
        }
        i = i - 1
    }

    let dir = "/"
    if last_slash >= 0 {
        dir = base.path.slice(0, last_slash + 1)
    }

    return normalize_url(origin + dir + trimmed)
}

fn get_file_extension(url) {
    if url == null {
        return ""
    }
    let clean = clean_fragment(url)
    let q_idx = index(clean, "?")
    if q_idx != -1 {
        clean = clean.slice(0, q_idx)
    }

    let last_dot = -1
    let i = 0
    while i < clean.len() {
        if clean.slice(i, i + 1) == "." {
            last_dot = i
        }
        i = i + 1
    }

    if last_dot != -1 {
        let ext = clean.slice(last_dot + 1, clean.len())
        if ext.len() >= 1 and ext.len() <= 6 {
            return ext.upper()
        }
    }
    return ""
}

# ------------------------------------------------------------
# Section 2: Security & SSRF Protection
# ------------------------------------------------------------

fn is_private_ip(host) {
    if host == null {
        return false
    }
    let h = host.lower()

    if h == "localhost" or h.ends_with(".localhost") or h == "127.0.0.1" or h == "0.0.0.0" {
        return true
    }
    if h == "::1" or h == "[::1]" or h.contains("::") {
        return true
    }

    let colon = index(h, ":")
    if colon != -1 and not h.starts_with("[") {
        h = h.slice(0, colon)
    }

    let parts = h.split(".")
    if parts.len() == 4 {
        let is_all_num = true
        let octets = []
        for p in parts {
            if p.len() == 0 {
                is_all_num = false
                break
            }
            let val = int(p)
            if string(val) != p or val < 0 or val > 255 {
                is_all_num = false
                break
            }
            octets.push(val)
        }

        if is_all_num {
            let o0 = octets[0]
            let o1 = octets[1]
            # 127.0.0.0/8 (Loopback)
            if o0 == 127 { return true }
            # 10.0.0.0/8 (Private network)
            if o0 == 10 { return true }
            # 172.16.0.0/12 (Private network: 172.16 - 172.31)
            if o0 == 172 and (o1 >= 16 and o1 <= 31) { return true }
            # 192.168.0.0/16 (Private network)
            if o0 == 192 and o1 == 168 { return true }
            # 169.254.0.0/16 (Link-local / cloud metadata)
            if o0 == 169 and o1 == 254 { return true }
            # 0.0.0.0/8
            if o0 == 0 { return true }
        }
    }
    return false
}

fn validate_target_url(url, allow_private_ips) {
    let p = parse_url(url)
    if not p.valid {
        return { valid: false, reason: "Invalid URL structure" }
    }
    if p.protocol != "http" and p.protocol != "https" {
        return { valid: false, reason: "Unsupported protocol: " + p.protocol }
    }
    if not allow_private_ips and is_private_ip(p.host) {
        return { valid: false, reason: "SSRF protection blocked destination: " + p.host }
    }
    return { valid: true, reason: "" }
}

# ------------------------------------------------------------
# Section 3: HTML DOM Tree & Tokenizer
# ------------------------------------------------------------

fn html_unescape(text) {
    if text == null {
        return ""
    }
    let s = text.replace("&amp;", "&")
    s = s.replace("&lt;", "<")
    s = s.replace("&gt;", ">")
    s = s.replace("&quot;", "\"")
    s = s.replace("&#39;", "'")
    s = s.replace("&apos;", "'")
    s = s.replace("&nbsp;", " ")
    return s
}

fn parse_attrs(tag_str) {
    let attrs = {}
    let i = 0
    let n = tag_str.len()

    while i < n {
        while i < n and (tag_str.slice(i, i + 1) == " " or tag_str.slice(i, i + 1) == "\t" or tag_str.slice(i, i + 1) == "\n" or tag_str.slice(i, i + 1) == "\r") {
            i = i + 1
        }
        if i >= n { break }

        let name_start = i
        while i < n {
            let c = tag_str.slice(i, i + 1)
            if c == "=" or c == " " or c == "\t" or c == "\n" or c == "\r" or c == "/" or c == ">" {
                break
            }
            i = i + 1
        }
        let attr_name = tag_str.slice(name_start, i).lower()
        if attr_name.len() == 0 {
            i = i + 1
            continue
        }

        while i < n and (tag_str.slice(i, i + 1) == " " or tag_str.slice(i, i + 1) == "\t" or tag_str.slice(i, i + 1) == "\n" or tag_str.slice(i, i + 1) == "\r") {
            i = i + 1
        }

        let attr_val = ""
        if i < n and tag_str.slice(i, i + 1) == "=" {
            i = i + 1
            while i < n and (tag_str.slice(i, i + 1) == " " or tag_str.slice(i, i + 1) == "\t" or tag_str.slice(i, i + 1) == "\n" or tag_str.slice(i, i + 1) == "\r") {
                i = i + 1
            }
            if i < n {
                let quote = tag_str.slice(i, i + 1)
                if quote == "\"" or quote == "'" {
                    i = i + 1
                    let val_start = i
                    while i < n and tag_str.slice(i, i + 1) != quote {
                        i = i + 1
                    }
                    attr_val = tag_str.slice(val_start, i)
                    if i < n { i = i + 1 }
                } else {
                    let val_start = i
                    while i < n {
                        let c = tag_str.slice(i, i + 1)
                        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == ">" or c == "/" {
                            break
                        }
                        i = i + 1
                    }
                    attr_val = tag_str.slice(val_start, i)
                }
            }
        }
        attrs[attr_name] = html_unescape(attr_val)
    }
    return attrs
}

fn parse_html(html) {
    let doc = {
        nodes: {},
        root_ids: [],
        next_id: 0
    }

    if html == null {
        return doc
    }

    let is_void = {
        "area": true, "base": true, "br": true, "col": true, "embed": true,
        "hr": true, "img": true, "input": true, "link": true, "meta": true,
        "param": true, "source": true, "track": true, "wbr": true
    }

    let is_raw = {
        "script": true, "style": true, "textarea": true, "title": true
    }

    let stack = []
    let i = 0
    let n = html.len()

    while i < n {
        let tag_open = index(html.slice(i, n), "<")
        if tag_open == -1 {
            let text = html.slice(i, n).trim()
            if text.len() > 0 {
                let nid = doc.next_id
                doc.next_id = doc.next_id + 1
                let parent_id = -1
                if stack.len() > 0 { parent_id = stack[stack.len() - 1] }
                doc.nodes[string(nid)] = {
                    id: nid,
                    type: "text",
                    tag: "#text",
                    text: html_unescape(text),
                    attributes: {},
                    children: [],
                    parent: parent_id
                }
                if parent_id != -1 {
                    let p = doc.nodes[string(parent_id)]
                    let ch = p.children
                    ch.push(nid)
                    p.children = ch
                    doc.nodes[string(parent_id)] = p
                } else {
                    doc.root_ids.push(nid)
                }
            }
            break
        }

        let tag_pos = i + tag_open
        if tag_pos > i {
            let text = html.slice(i, tag_pos)
            let trimmed = text.trim()
            if trimmed.len() > 0 {
                let nid = doc.next_id
                doc.next_id = doc.next_id + 1
                let parent_id = -1
                if stack.len() > 0 { parent_id = stack[stack.len() - 1] }
                doc.nodes[string(nid)] = {
                    id: nid,
                    type: "text",
                    tag: "#text",
                    text: html_unescape(trimmed),
                    attributes: {},
                    children: [],
                    parent: parent_id
                }
                if parent_id != -1 {
                    let p = doc.nodes[string(parent_id)]
                    let ch = p.children
                    ch.push(nid)
                    p.children = ch
                    doc.nodes[string(parent_id)] = p
                } else {
                    doc.root_ids.push(nid)
                }
            }
        }

        # Check comment
        if html.slice(tag_pos, tag_pos + 4) == "<!--" {
            let comment_end = index(html.slice(tag_pos + 4, n), "-->")
            if comment_end == -1 { break }
            i = tag_pos + 4 + comment_end + 3
            continue
        }

        # Check doctype
        if html.slice(tag_pos, tag_pos + 2).lower() == "<!" {
            let dt_end = index(html.slice(tag_pos, n), ">")
            if dt_end == -1 { break }
            i = tag_pos + dt_end + 1
            continue
        }

        let tag_close = index(html.slice(tag_pos, n), ">")
        if tag_close == -1 { break }
        let full_tag = html.slice(tag_pos + 1, tag_pos + tag_close).trim()
        i = tag_pos + tag_close + 1

        # Closing tag
        if full_tag.starts_with("/") {
            let close_name = full_tag.slice(1, full_tag.len()).trim().lower()
            let found_idx = -1
            let k = stack.len() - 1
            while k >= 0 {
                let candidate = doc.nodes[string(stack[k])]
                if candidate.tag == close_name {
                    found_idx = k
                    break
                }
                k = k - 1
            }
            if found_idx != -1 {
                while stack.len() > found_idx {
                    stack.pop()
                }
            }
            continue
        }

        let is_self_closing = false
        if full_tag.ends_with("/") {
            is_self_closing = true
            full_tag = full_tag.slice(0, full_tag.len() - 1).trim()
        }

        let first_space = index(full_tag, " ")
        let tag_name = ""
        let attrs_str = ""
        if first_space == -1 {
            tag_name = full_tag.lower()
        } else {
            tag_name = full_tag.slice(0, first_space).lower()
            attrs_str = full_tag.slice(first_space + 1, full_tag.len())
        }

        let parsed_attrs = parse_attrs(attrs_str)
        let nid = doc.next_id
        doc.next_id = doc.next_id + 1
        let parent_id = -1
        if stack.len() > 0 { parent_id = stack[stack.len() - 1] }

        doc.nodes[string(nid)] = {
            id: nid,
            type: "element",
            tag: tag_name,
            text: "",
            attributes: parsed_attrs,
            children: [],
            parent: parent_id
        }

        if parent_id != -1 {
            let p = doc.nodes[string(parent_id)]
            let ch = p.children
            ch.push(nid)
            p.children = ch
            doc.nodes[string(parent_id)] = p
        } else {
            doc.root_ids.push(nid)
        }

        if is_raw[tag_name] == true {
            let end_pattern = "</" + tag_name + ">"
            let lower_rem = html.slice(i, n).lower()
            let raw_end = index(lower_rem, end_pattern)
            if raw_end != -1 {
                let raw_content = html.slice(i, i + raw_end)
                i = i + raw_end + end_pattern.len()
                let cid = doc.next_id
                doc.next_id = doc.next_id + 1
                doc.nodes[string(cid)] = {
                    id: cid,
                    type: "text",
                    tag: "#text",
                    text: raw_content,
                    attributes: {},
                    children: [],
                    parent: nid
                }
                let cur = doc.nodes[string(nid)]
                let ch = cur.children
                ch.push(cid)
                cur.children = ch
                doc.nodes[string(nid)] = cur
            }
            continue
        }

        if is_void[tag_name] != true and not is_self_closing {
            stack.push(nid)
        }
    }
    return doc
}

fn node_text(doc, nid) {
    if nid == null { return "" }
    let node = doc.nodes[string(nid)]
    if node == null { return "" }
    if node.type == "text" { return node.text }

    let parts = []
    for cid in node.children {
        let t = node_text(doc, cid)
        if t.len() > 0 { parts.push(t) }
    }
    return join(parts, " ")
}

fn node_attr(doc, nid, attr_name) {
    if nid == null or attr_name == null { return "" }
    let node = doc.nodes[string(nid)]
    if node == null or node.type != "element" { return "" }
    let lower_name = attr_name.lower()
    if node.attributes.has(lower_name) {
        return node.attributes[lower_name]
    }
    return ""
}

fn node_inner_html(doc, nid) {
    if nid == null { return "" }
    let node = doc.nodes[string(nid)]
    if node == null { return "" }
    if node.type == "text" { return node.text }
    let inner = ""
    for cid in node.children {
        inner = inner + node_html(doc, cid)
    }
    return inner
}

fn node_html(doc, nid) {
    if nid == null { return "" }
    let node = doc.nodes[string(nid)]
    if node == null { return "" }
    if node.type == "text" { return node.text }

    let parts = ["<" + node.tag]
    for k in node.attributes.keys() {
        let v = node.attributes[k]
        parts.push(k + "=\"" + v.replace("\"", "&quot;") + "\"")
    }
    let tag_head = join(parts, " ")

    let is_void = {
        "area": true, "base": true, "br": true, "col": true, "embed": true,
        "hr": true, "img": true, "input": true, "link": true, "meta": true,
        "param": true, "source": true, "track": true, "wbr": true
    }

    if is_void.has(node.tag) {
        return tag_head + " />"
    }

    let inner = node_inner_html(doc, nid)
    return tag_head + ">" + inner + "</" + node.tag + ">"
}

fn get_all_element_descendants(doc, nid) {
    let res = []
    if nid == null { return res }
    let node = doc.nodes[string(nid)]
    if node == null { return res }
    for cid in node.children {
        let child = doc.nodes[string(cid)]
        if child != null and child.type == "element" {
            res.push(cid)
        }
        let sub = get_all_element_descendants(doc, cid)
        for s in sub { res.push(s) }
    }
    return res
}

fn get_all_doc_elements(doc) {
    let res = []
    let total = doc.next_id
    let i = 0
    while i < total {
        let node = doc.nodes[string(i)]
        if node != null and node.type == "element" {
            res.push(i)
        }
        i = i + 1
    }
    return res
}

# ------------------------------------------------------------
# Section 4: Full CSS Selector Engine
# ------------------------------------------------------------

fn is_ident_char(ch) {
    if ch >= "a" and ch <= "z" { return true }
    if ch >= "A" and ch <= "Z" { return true }
    if ch >= "0" and ch <= "9" { return true }
    if ch == "-" or ch == "_" { return true }
    return false
}

fn parse_unit(s) {
    let unit = {
        tag: "",
        id: "",
        classes: [],
        attributes: [],
        pseudos: []
    }

    let i = 0
    let n = s.len()

    if i < n and (is_ident_char(s.slice(i, i + 1)) or s.slice(i, i + 1) == "*") {
        let start = i
        while i < n and (is_ident_char(s.slice(i, i + 1)) or s.slice(i, i + 1) == "*") {
            i = i + 1
        }
        unit.tag = s.slice(start, i).lower()
    }

    while i < n {
        let ch = s.slice(i, i + 1)
        if ch == "#" {
            i = i + 1
            let start = i
            while i < n and is_ident_char(s.slice(i, i + 1)) { i = i + 1 }
            unit.id = s.slice(start, i)
        } else if ch == "." {
            i = i + 1
            let start = i
            while i < n and is_ident_char(s.slice(i, i + 1)) { i = i + 1 }
            unit.classes.push(s.slice(start, i))
        } else if ch == "[" {
            i = i + 1
            let start = i
            let in_quote = ""
            while i < n {
                let c = s.slice(i, i + 1)
                if in_quote != "" {
                    if c == in_quote { in_quote = "" }
                } else {
                    if c == "\"" or c == "'" { in_quote = c }
                    else if c == "]" { break }
                }
                i = i + 1
            }
            let raw_attr = s.slice(start, i).trim()
            if i < n { i = i + 1 }

            let op = ""
            let op_pos = -1
            let op_len = 1
            let cand_ops = ["^=", "$=", "*=", "~=", "="]
            for o in cand_ops {
                let idx = index(raw_attr, o)
                if idx != -1 {
                    op = o
                    op_pos = idx
                    op_len = o.len()
                    break
                }
            }

            if op_pos != -1 {
                let attr_name = raw_attr.slice(0, op_pos).trim().lower()
                let attr_val = raw_attr.slice(op_pos + op_len, raw_attr.len()).trim()
                if (attr_val.starts_with("\"") and attr_val.ends_with("\"")) or
                   (attr_val.starts_with("'") and attr_val.ends_with("'")) {
                    attr_val = attr_val.slice(1, attr_val.len() - 1)
                }
                unit.attributes.push({ name: attr_name, op: op, val: attr_val })
            } else {
                unit.attributes.push({ name: raw_attr.lower(), op: "", val: "" })
            }
        } else if ch == ":" {
            i = i + 1
            let start = i
            while i < n and (is_ident_char(s.slice(i, i + 1)) or s.slice(i, i + 1) == "-") {
                i = i + 1
            }
            let pname = s.slice(start, i).lower()
            let parg = ""
            if i < n and s.slice(i, i + 1) == "(" {
                i = i + 1
                let arg_start = i
                while i < n and s.slice(i, i + 1) != ")" { i = i + 1 }
                parg = s.slice(arg_start, i).trim()
                if i < n { i = i + 1 }
            }
            unit.pseudos.push({ name: pname, arg: parg })
        } else {
            i = i + 1
        }
    }
    return unit
}

fn split_selector_groups(s) {
    let groups = []
    let i = 0
    let n = s.len()
    let start = 0
    let in_bracket = 0
    let in_paren = 0
    let in_quote = ""

    while i < n {
        let c = s.slice(i, i + 1)
        if in_quote != "" {
            if c == in_quote { in_quote = "" }
        } else {
            if c == "\"" or c == "'" { in_quote = c }
            else if c == "[" { in_bracket = in_bracket + 1 }
            else if c == "]" and in_bracket > 0 { in_bracket = in_bracket - 1 }
            else if c == "(" { in_paren = in_paren + 1 }
            else if c == ")" and in_paren > 0 { in_paren = in_paren - 1 }
            else if c == "," and in_bracket == 0 and in_paren == 0 {
                let part = s.slice(start, i).trim()
                if part.len() > 0 { groups.push(part) }
                start = i + 1
            }
        }
        i = i + 1
    }
    let last = s.slice(start, n).trim()
    if last.len() > 0 { groups.push(last) }
    return groups
}

fn tokenize_group(s) {
    let steps = []
    let i = 0
    let n = s.len()
    let current_comb = ""

    while i < n {
        while i < n and (s.slice(i, i + 1) == " " or s.slice(i, i + 1) == "\t") {
            i = i + 1
        }
        if i >= n { break }

        if s.slice(i, i + 1) == ">" {
            current_comb = ">"
            i = i + 1
            while i < n and (s.slice(i, i + 1) == " " or s.slice(i, i + 1) == "\t") {
                i = i + 1
            }
        }

        let start = i
        let in_bracket = 0
        let in_paren = 0
        let in_quote = ""

        while i < n {
            let c = s.slice(i, i + 1)
            if in_quote != "" {
                if c == in_quote { in_quote = "" }
            } else {
                if c == "\"" or c == "'" { in_quote = c }
                else if c == "[" { in_bracket = in_bracket + 1 }
                else if c == "]" and in_bracket > 0 { in_bracket = in_bracket - 1 }
                else if c == "(" { in_paren = in_paren + 1 }
                else if c == ")" and in_paren > 0 { in_paren = in_paren - 1 }
                else if in_bracket == 0 and in_paren == 0 {
                    if c == " " or c == "\t" or c == ">" {
                        break
                    }
                }
            }
            i = i + 1
        }

        let unit_str = s.slice(start, i).trim()
        if unit_str.len() > 0 {
            steps.push({ combinator: current_comb, unit: parse_unit(unit_str) })
        }

        current_comb = " "
        while i < n and (s.slice(i, i + 1) == " " or s.slice(i, i + 1) == "\t") {
            i = i + 1
        }
        if i < n and s.slice(i, i + 1) == ">" {
            current_comb = ">"
            i = i + 1
        }
    }
    return steps
}

fn node_has_class(node, cls) {
    if not node.attributes.has("class") { return false }
    let raw = node.attributes["class"]
    let parts = raw.split(" ")
    for p in parts {
        if p.trim() == cls { return true }
    }
    return false
}

fn matches_unit(doc, nid, unit) {
    let node = doc.nodes[string(nid)]
    if node == null or node.type != "element" { return false }

    if unit.tag.len() > 0 and unit.tag != "*" {
        if node.tag != unit.tag { return false }
    }

    if unit.id.len() > 0 {
        if not node.attributes.has("id") or node.attributes["id"] != unit.id {
            return false
        }
    }

    for c in unit.classes {
        if not node_has_class(node, c) { return false }
    }

    for attr in unit.attributes {
        if not node.attributes.has(attr.name) { return false }
        let val = node.attributes[attr.name]
        if attr.op == "=" {
            if val != attr.val { return false }
        } else if attr.op == "^=" {
            if not val.starts_with(attr.val) { return false }
        } else if attr.op == "$=" {
            if not val.ends_with(attr.val) { return false }
        } else if attr.op == "*=" {
            if not val.contains(attr.val) { return false }
        } else if attr.op == "~=" {
            let words = val.split(" ")
            let found = false
            for w in words {
                if w.trim() == attr.val { found = true; break }
            }
            if not found { return false }
        }
    }

    for p in unit.pseudos {
        if p.name == "first-child" {
            if node.parent == -1 { return false }
            let parent_node = doc.nodes[string(node.parent)]
            let first_elem_id = -1
            for cid in parent_node.children {
                if doc.nodes[string(cid)].type == "element" {
                    first_elem_id = cid
                    break
                }
            }
            if first_elem_id != nid { return false }
        } else if p.name == "last-child" {
            if node.parent == -1 { return false }
            let parent_node = doc.nodes[string(node.parent)]
            let last_elem_id = -1
            let k = parent_node.children.len() - 1
            while k >= 0 {
                let cid = parent_node.children[k]
                if doc.nodes[string(cid)].type == "element" {
                    last_elem_id = cid
                    break
                }
                k = k - 1
            }
            if last_elem_id != nid { return false }
        } else if p.name == "nth-child" {
            if node.parent == -1 { return false }
            let parent_node = doc.nodes[string(node.parent)]
            let elem_idx = 1
            let my_idx = -1
            for cid in parent_node.children {
                if doc.nodes[string(cid)].type == "element" {
                    if cid == nid {
                        my_idx = elem_idx
                        break
                    }
                    elem_idx = elem_idx + 1
                }
            }
            if my_idx == -1 { return false }

            if p.arg == "odd" {
                if my_idx % 2 == 0 { return false }
            } else if p.arg == "even" {
                if my_idx % 2 != 0 { return false }
            } else {
                let target = int(p.arg)
                if my_idx != target { return false }
            }
        } else if p.name == "not" {
            let inner_unit = parse_unit(p.arg)
            if matches_unit(doc, nid, inner_unit) { return false }
        }
    }

    return true
}

fn matches_selector(doc, nid, selector) {
    let groups = split_selector_groups(selector)
    for g in groups {
        let steps = tokenize_group(g)
        if steps.len() == 1 {
            if matches_unit(doc, nid, steps[0].unit) { return true }
        } else {
            let all_matches = query_selector_all(doc, g, null)
            for mid in all_matches {
                if mid == nid { return true }
            }
        }
    }
    return false
}

fn query_selector_group(doc, steps, context_nid) {
    if steps.len() == 0 { return [] }

    let current = []
    let step0 = steps[0]

    if context_nid != null {
        if step0.combinator == ">" {
            let p = doc.nodes[string(context_nid)]
            for cid in p.children {
                if doc.nodes[string(cid)].type == "element" and matches_unit(doc, cid, step0.unit) {
                    current.push(cid)
                }
            }
        } else {
            let desc = get_all_element_descendants(doc, context_nid)
            for cid in desc {
                if matches_unit(doc, cid, step0.unit) {
                    current.push(cid)
                }
            }
        }
    } else {
        let all_elems = get_all_doc_elements(doc)
        for nid in all_elems {
            if matches_unit(doc, nid, step0.unit) {
                current.push(nid)
            }
        }
    }

    let step_idx = 1
    while step_idx < steps.len() {
        let step = steps[step_idx]
        let next_candidates = []
        let seen = {}

        for cand_id in current {
            if step.combinator == ">" {
                let parent_node = doc.nodes[string(cand_id)]
                for cid in parent_node.children {
                    if doc.nodes[string(cid)].type == "element" and matches_unit(doc, cid, step.unit) {
                        let k = string(cid)
                        if not seen.has(k) {
                            seen[k] = true
                            next_candidates.push(cid)
                        }
                    }
                }
            } else {
                let desc = get_all_element_descendants(doc, cand_id)
                for cid in desc {
                    if matches_unit(doc, cid, step.unit) {
                        let k = string(cid)
                        if not seen.has(k) {
                            seen[k] = true
                            next_candidates.push(cid)
                        }
                    }
                }
            }
        }
        current = next_candidates
        step_idx = step_idx + 1
    }

    return current
}

fn query_selector_all(doc, selector, context_nid) {
    let groups = split_selector_groups(selector)
    let seen = {}
    let all_matches = []

    for g in groups {
        let steps = tokenize_group(g)
        let matches = query_selector_group(doc, steps, context_nid)
        for nid in matches {
            let k = string(nid)
            if not seen.has(k) {
                seen[k] = true
                all_matches.push(nid)
            }
        }
    }
    return all_matches
}

fn query_selector(doc, selector, context_nid) {
    let matches = query_selector_all(doc, selector, context_nid)
    if matches.len() > 0 { return matches[0] }
    return null
}

# ------------------------------------------------------------
# Section 5: Schema Extraction, Metadata, & JSON-LD
# ------------------------------------------------------------

fn extract_field(doc, context_nid, rule) {
    if typeof(rule) == "string" {
        let nid = query_selector(doc, rule, context_nid)
        if nid == null { return "" }
        return node_text(doc, nid)
    }

    if typeof(rule) != "map" {
        return null
    }

    let selector = ""
    if rule.has("selector") { selector = rule.selector }
    let attr = "text"
    if rule.has("attribute") { attr = rule.attribute }
    let is_multiple = false
    if rule.has("multiple") { is_multiple = rule.multiple }

    if is_multiple {
        let matches = []
        if selector.len() > 0 {
            matches = query_selector_all(doc, selector, context_nid)
        } else if context_nid != null {
            matches = [context_nid]
        }

        let res_list = []
        for nid in matches {
            if rule.has("fields") {
                let item_map = {}
                for k in rule.fields.keys() {
                    item_map[k] = extract_field(doc, nid, rule.fields[k])
                }
                res_list.push(item_map)
            } else {
                if attr == "text" {
                    res_list.push(node_text(doc, nid))
                } else if attr == "html" {
                    res_list.push(node_html(doc, nid))
                } else if attr == "inner_html" {
                    res_list.push(node_inner_html(doc, nid))
                } else {
                    res_list.push(node_attr(doc, nid, attr))
                }
            }
        }
        return res_list
    }

    let nid = context_nid
    if selector.len() > 0 {
        nid = query_selector(doc, selector, context_nid)
    }
    if nid == null { return null }

    if rule.has("fields") {
        let item_map = {}
        for k in rule.fields.keys() {
            item_map[k] = extract_field(doc, nid, rule.fields[k])
        }
        return item_map
    }

    if attr == "text" {
        return node_text(doc, nid)
    } else if attr == "html" {
        return node_html(doc, nid)
    } else if attr == "inner_html" {
        return node_inner_html(doc, nid)
    }
    return node_attr(doc, nid, attr)
}

fn extract(doc_or_html, schema) {
    let doc = doc_or_html
    if typeof(doc_or_html) == "string" {
        doc = parse_html(doc_or_html)
    }
    let result = {}
    for key in schema.keys() {
        result[key] = extract_field(doc, null, schema[key])
    }
    return result
}

fn extract_metadata(doc_or_html) {
    let doc = doc_or_html
    if typeof(doc_or_html) == "string" {
        doc = parse_html(doc_or_html)
    }

    let meta = {
        title: "",
        description: "",
        keywords: "",
        canonical: "",
        language: "",
        author: "",
        og: {},
        twitter: {}
    }

    let total = doc.next_id
    let i = 0
    while i < total {
        let node = doc.nodes[string(i)]
        if node != null and node.type == "element" {
            let t = node.tag
            if t == "html" {
                if node.attributes.has("lang") {
                    meta.language = node.attributes["lang"]
                }
            } else if t == "title" {
                meta.title = node_text(doc, i).trim()
            } else if t == "link" {
                if node.attributes.has("rel") and node.attributes["rel"] == "canonical" {
                    if node.attributes.has("href") {
                        meta.canonical = node.attributes["href"]
                    }
                }
            } else if t == "meta" {
                let content = ""
                if node.attributes.has("content") {
                    content = node.attributes["content"]
                }

                if node.attributes.has("property") {
                    let prop = node.attributes["property"].lower()
                    if prop.starts_with("og:") {
                        let k = prop.slice(3, prop.len())
                        meta.og[k] = content
                    }
                }

                if node.attributes.has("name") {
                    let name = node.attributes["name"].lower()
                    if name == "description" {
                        meta.description = content
                    } else if name == "keywords" {
                        meta.keywords = content
                    } else if name == "author" {
                        meta.author = content
                    } else if name.starts_with("twitter:") {
                        let k = name.slice(8, name.len())
                        meta.twitter[k] = content
                    }
                }
            }
        }
        i = i + 1
    }

    if meta.title == "" and meta.og.has("title") {
        meta.title = meta.og["title"]
    }
    if meta.description == "" and meta.og.has("description") {
        meta.description = meta.og["description"]
    }

    return meta
}

fn extract_json_ld(doc_or_html) {
    let doc = doc_or_html
    if typeof(doc_or_html) == "string" {
        doc = parse_html(doc_or_html)
    }

    let items = []
    let total = doc.next_id
    let i = 0
    while i < total {
        let node = doc.nodes[string(i)]
        if node != null {
            if node.type == "element" {
                if node.tag == "script" {
                    if node.attributes.has("type") {
                        if node.attributes["type"].lower() == "application/ld+json" {
                            let raw_content = ""
                            for cid in node.children {
                                let c = doc.nodes[string(cid)]
                                if c != null {
                                    if c.type == "text" {
                                        raw_content = raw_content + c.text
                                    }
                                }
                            }
                            let s = raw_content.trim()
                            if (s.starts_with("{") and s.ends_with("}")) or (s.starts_with("[") and s.ends_with("]")) {
                                let parsed = json.parse(s)
                                if typeof(parsed) == "array" {
                                    for p in parsed { items.push(p) }
                                } else if typeof(parsed) == "map" {
                                    items.push(parsed)
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return items
}

fn extract_tables(doc_or_html) {
    let doc = doc_or_html
    if typeof(doc_or_html) == "string" {
        doc = parse_html(doc_or_html)
    }

    let tables = []
    let table_ids = query_selector_all(doc, "table", null)
    let idx = 0

    for tid in table_ids {
        let headers = []
        let th_ids = query_selector_all(doc, "th", tid)
        for thid in th_ids {
            headers.push(node_text(doc, thid).trim())
        }

        let rows = []
        let tr_ids = query_selector_all(doc, "tr", tid)
        for trid in tr_ids {
            let cells = []
            let td_ids = query_selector_all(doc, "td", trid)
            if td_ids.len() > 0 {
                for tdid in td_ids {
                    cells.push(node_text(doc, tdid).trim())
                }
                rows.push(cells)
            }
        }

        tables.push({
            index: idx,
            headers: headers,
            rows: rows
        })
        idx = idx + 1
    }
    return tables
}

# ------------------------------------------------------------
# Section 6: Robots.txt & Sitemap Parsers
# ------------------------------------------------------------

fn parse_robots_txt(content, target_ua) {
    let lines = content.split("\n")
    let current_uas = []
    let rules = []
    let sitemaps = []

    for raw_line in lines {
        let line = raw_line.trim()
        if line.starts_with("#") or line.len() == 0 {
            continue
        }

        let colon = index(line, ":")
        if colon == -1 { continue }

        let field = line.slice(0, colon).trim().lower()
        let val = line.slice(colon + 1, line.len()).trim()

        if field == "user-agent" {
            current_uas.push(val.lower())
        } else if field == "disallow" {
            for ua in current_uas {
                rules.push({ ua: ua, type: "disallow", path: val })
            }
        } else if field == "allow" {
            for ua in current_uas {
                rules.push({ ua: ua, type: "allow", path: val })
            }
        } else if field == "sitemap" {
            sitemaps.push(val)
        }
    }

    return { rules: rules, sitemaps: sitemaps }
}

fn is_robots_allowed(robots, path, target_ua) {
    if robots == null { return true }
    let lower_ua = target_ua.lower()

    let has_specific = false
    for r in robots.rules {
        if r.ua == lower_ua {
            has_specific = true
            break
        }
    }

    let active_rules = []
    for r in robots.rules {
        if has_specific and r.ua == lower_ua {
            active_rules.push(r)
        } else if not has_specific and r.ua == "*" {
            active_rules.push(r)
        }
    }

    let best_match_len = -1
    let best_match_type = "allow"

    for r in active_rules {
        if r.path == "" { continue }
        if path.starts_with(r.path) {
            let plen = r.path.len()
            if plen > best_match_len {
                best_match_len = plen
                best_match_type = r.type
            } else if plen == best_match_len and r.type == "allow" {
                best_match_type = "allow"
            }
        }
    }

    if best_match_type == "disallow" {
        return false
    }
    return true
}

fn parse_sitemap(xml_content) {
    let doc = parse_html(xml_content)
    let locs = query_selector_all(doc, "loc", null)
    let urls = []
    for lid in locs {
        let txt = node_text(doc, lid).trim()
        if txt.len() > 0 {
            urls.push(txt)
        }
    }
    return urls
}

# ------------------------------------------------------------
# Section 7: Asset Classifiers & Categorized Extraction
# ------------------------------------------------------------

fn is_image_ext(ext) {
    let list = ["PNG", "JPG", "JPEG", "GIF", "WEBP", "SVG", "ICO", "BMP", "AVIF", "TIFF"]
    for e in list {
        if ext == e { return true }
    }
    return false
}

fn is_video_ext(ext) {
    let list = ["MP4", "WEBM", "OGV", "MOV", "M4V", "AVI", "MKV", "FLV", "WMV", "MP3", "WAV", "OGG", "FLAC", "AAC", "M4A"]
    for e in list {
        if ext == e { return true }
    }
    return false
}

fn is_document_file_ext(ext) {
    let list = ["PDF", "ZIP", "TAR", "GZ", "RAR", "7Z", "DOC", "DOCX", "XLS", "XLSX",
                "PPT", "PPTX", "ODT", "ODS", "ODP", "TXT", "RTF", "CSV", "JSON", "XML", "EPUB"]
    for e in list {
        if ext == e { return true }
    }
    return false
}

fn extract_page_data(arg1, arg2) {
    let current_url = ""
    let html = ""

    if arg1.starts_with("http://") or arg1.starts_with("https://") {
        current_url = arg1
        html = arg2
    } else {
        html = arg1
        current_url = arg2
    }

    let doc = parse_html(html)
    let meta = extract_metadata(doc)
    let json_ld = extract_json_ld(doc)
    let tables = extract_tables(doc)

    # Headings
    let h1_nodes = query_selector_all(doc, "h1", null)
    let h1_list = []
    for hid in h1_nodes {
        h1_list.push({ tag: "h1", inner: node_text(doc, hid).trim() })
    }

    let h2_nodes = query_selector_all(doc, "h2", null)
    let h2_list = []
    for hid in h2_nodes {
        h2_list.push({ tag: "h2", inner: node_text(doc, hid).trim() })
    }

    let h3_nodes = query_selector_all(doc, "h3", null)
    let h3_list = []
    for hid in h3_nodes {
        h3_list.push({ tag: "h3", inner: node_text(doc, hid).trim() })
    }

    # Paragraphs
    let p_nodes = query_selector_all(doc, "p", null)
    let p_list = []
    for pid in p_nodes {
        let t = node_text(doc, pid).trim()
        if t.len() > 0 {
            p_list.push({ tag: "p", inner: t })
        }
    }

    # Images
    let img_items = []
    let seen_imgs = {}
    let img_nodes = query_selector_all(doc, "img", null)

    for iid in img_nodes {
        let src = node_attr(doc, iid, "src")
        if src.len() > 0 {
            let abs_src = resolve_url(current_url, src)
            if abs_src != null {
                if not seen_imgs.has(abs_src) {
                    seen_imgs[abs_src] = true
                    let alt = node_attr(doc, iid, "alt")
                    let w = node_attr(doc, iid, "width")
                    let h = node_attr(doc, iid, "height")
                    let ext = get_file_extension(abs_src)
                    if ext.len() == 0 { ext = "IMG" }

                    let dim = ""
                    if w.len() > 0 and h.len() > 0 {
                        dim = w + "x" + h
                    } else if w.len() > 0 {
                        dim = w + "w"
                    }

                    img_items.push({
                        url: abs_src,
                        alt: alt,
                        format: ext,
                        dimensions: dim
                    })
                }
            }
        }
    }

    # Videos & Media
    let video_items = []
    let seen_videos = {}

    let video_nodes = query_selector_all(doc, "video", null)
    for vid in video_nodes {
        let src = node_attr(doc, vid, "src")
        if src.len() > 0 {
            let abs_src = resolve_url(current_url, src)
            if abs_src != null and not seen_videos.has(abs_src) {
                seen_videos[abs_src] = true
                video_items.push({
                    type: "VIDEO TAG",
                    url: abs_src,
                    format: get_file_extension(abs_src)
                })
            }
        }
    }

    let source_nodes = query_selector_all(doc, "source", null)
    for sid in source_nodes {
        let src = node_attr(doc, sid, "src")
        let mime = node_attr(doc, sid, "type")
        if src.len() > 0 {
            let abs_src = resolve_url(current_url, src)
            if abs_src != null and not seen_videos.has(abs_src) {
                seen_videos[abs_src] = true
                let vtype = "SOURCE"
                if mime.len() > 0 { vtype = mime }
                video_items.push({
                    type: vtype,
                    url: abs_src,
                    format: get_file_extension(abs_src)
                })
            }
        }
    }

    let iframe_nodes = query_selector_all(doc, "iframe", null)
    for ifid in iframe_nodes {
        let src = node_attr(doc, ifid, "src")
        if src.len() > 0 {
            let lower_src = src.lower()
            if lower_src.contains("youtube") or lower_src.contains("youtu.be") or lower_src.contains("vimeo") or lower_src.contains("player") or lower_src.contains("embed") {
                let abs_src = resolve_url(current_url, src)
                if abs_src == null { abs_src = src }
                if not seen_videos.has(abs_src) {
                    seen_videos[abs_src] = true
                    video_items.push({
                        type: "VIDEO EMBED",
                        url: abs_src,
                        format: "EMBED"
                    })
                }
            }
        }
    }

    # Files & Links
    let file_items = []
    let internal_links = []
    let external_links = []
    let crawlable_links = []
    let seen_links = {}

    let a_nodes = query_selector_all(doc, "a[href]", null)
    for aid in a_nodes {
        let href = node_attr(doc, aid, "href")
        let label = node_text(doc, aid).trim()
        if href.len() > 0 {
            let resolved = resolve_url(current_url, href)
            if resolved != null {
                if not seen_links.has(resolved) {
                    seen_links[resolved] = true
                    let ext = get_file_extension(resolved)

                    if is_video_ext(ext) {
                        if not seen_videos.has(resolved) {
                            seen_videos[resolved] = true
                            video_items.push({
                                type: "MEDIA LINK (" + ext + ")",
                                url: resolved,
                                format: ext
                            })
                        }
                    } else if is_document_file_ext(ext) {
                        file_items.push({
                            format: ext,
                            label: label,
                            url: resolved
                        })
                    } else {
                        let is_internal = same_host(resolved, current_url)
                        let link_obj = {
                            label: label,
                            url: resolved
                        }
                        if is_internal {
                            internal_links.push(link_obj)
                            crawlable_links.push(resolved)
                        } else {
                            external_links.push(link_obj)
                        }
                    }
                }
            }
        }
    }

    # Resources
    let resource_items = []
    let link_nodes = query_selector_all(doc, "link", null)
    for lkid in link_nodes {
        let rel = node_attr(doc, lkid, "rel").lower()
        let href = node_attr(doc, lkid, "href")
        if href.len() > 0 {
            let abs_href = resolve_url(current_url, href)
            if abs_href != null {
                if rel.contains("stylesheet") {
                    resource_items.push({ kind: "CSS STYLESHEET", url: abs_href })
                } else if rel.contains("icon") {
                    resource_items.push({ kind: "FAVICON", url: abs_href })
                } else if rel.contains("canonical") {
                    resource_items.push({ kind: "CANONICAL", url: abs_href })
                }
            }
        }
    }

    let script_nodes = query_selector_all(doc, "script[src]", null)
    for scid in script_nodes {
        let src = node_attr(doc, scid, "src")
        if src.len() > 0 {
            let abs_src = resolve_url(current_url, src)
            if abs_src != null {
                resource_items.push({ kind: "JAVASCRIPT", url: abs_src })
            }
        }
    }

    return {
        url: current_url,
        doc: doc,
        txt: {
            title: meta.title,
            meta_description: meta.description,
            meta_keywords: meta.keywords,
            meta_author: meta.author,
            open_graph: meta.og,
            twitter: meta.twitter,
            h1: h1_list,
            h2: h2_list,
            h3: h3_list,
            paragraphs: p_list
        },
        metadata: meta,
        json_ld: json_ld,
        tables: tables,
        img: img_items,
        video: video_items,
        files: file_items,
        links: {
            internal: internal_links,
            external: external_links
        },
        crawlable_links: crawlable_links,
        more_data: resource_items
    }
}

# ------------------------------------------------------------
# Section 8: Categorized Table Formatting & Data Export
# ------------------------------------------------------------

fn pad_right(s, width) {
    let str_val = string(s)
    let pad_len = width - str_val.len()
    if pad_len <= 0 {
        if str_val.len() > width and width > 3 {
            return str_val.slice(0, width - 3) + "..."
        }
        return str_val
    }
    let res = str_val
    let i = 0
    while i < pad_len {
        res = res + " "
        i = i + 1
    }
    return res
}

fn draw_divider(widths) {
    let parts = ["+"]
    for w in widths {
        let seg = ""
        let i = 0
        while i < w + 2 {
            seg = seg + "-"
            i = i + 1
        }
        parts.push(seg)
        parts.push("+")
    }
    return join(parts, "")
}

fn draw_row(cols, widths) {
    let parts = ["|"]
    let idx = 0
    for w in widths {
        let val = ""
        if idx < cols.len() {
            val = string(cols[idx])
        }
        parts.push(" " + pad_right(val, w) + " |")
        idx = idx + 1
    }
    return join(parts, "")
}

fn print_category_header(cat_name, count) {
    echo("")
    echo("================================================================================")
    echo(" [CATUGURY] " + cat_name + " (Total: " + string(count) + ")")
    echo("================================================================================")
}

fn print_page_tables(page_data) {
    # Table 1: Metadata
    print_category_header("PAGE TEXT & METADATA (txt)", 6)
    let meta_w = [22, 54]
    echo(draw_divider(meta_w))
    echo(draw_row(["Field", "Value"], meta_w))
    echo(draw_divider(meta_w))
    echo(draw_row(["Title", page_data.txt.title], meta_w))
    echo(draw_row(["Description", page_data.txt.meta_description], meta_w))
    echo(draw_row(["Keywords", page_data.txt.meta_keywords], meta_w))
    echo(draw_row(["Author", page_data.txt.meta_author], meta_w))
    if page_data.txt.open_graph.has("title") {
        echo(draw_row(["OpenGraph Title", page_data.txt.open_graph.title], meta_w))
    }
    if page_data.txt.open_graph.has("image") {
        echo(draw_row(["OpenGraph Image", page_data.txt.open_graph.image], meta_w))
    }
    echo(draw_divider(meta_w))

    # Table 2: Headings
    let total_headings = page_data.txt.h1.len() + page_data.txt.h2.len() + page_data.txt.h3.len()
    print_category_header("HEADINGS HIERARCHY (txt)", total_headings)
    let head_w = [6, 8, 62]
    echo(draw_divider(head_w))
    echo(draw_row(["#", "Tag", "Heading Content"], head_w))
    echo(draw_divider(head_w))
    let h_idx = 1
    for h in page_data.txt.h1 {
        echo(draw_row([string(h_idx), "H1", h.inner], head_w))
        h_idx = h_idx + 1
    }
    for h in page_data.txt.h2 {
        echo(draw_row([string(h_idx), "H2", h.inner], head_w))
        h_idx = h_idx + 1
    }
    for h in page_data.txt.h3 {
        echo(draw_row([string(h_idx), "H3", h.inner], head_w))
        h_idx = h_idx + 1
    }
    if total_headings == 0 {
        echo(draw_row(["-", "NONE", "(No headings found on this page)"], head_w))
    }
    echo(draw_divider(head_w))

    # Table 3: Paragraphs
    print_category_header("TEXT PARAGRAPHS (txt)", page_data.txt.paragraphs.len())
    let p_w = [6, 72]
    echo(draw_divider(p_w))
    echo(draw_row(["#", "Paragraph Text Snippet"], p_w))
    echo(draw_divider(p_w))
    let p_idx = 1
    for p in page_data.txt.paragraphs {
        echo(draw_row([string(p_idx), p.inner], p_w))
        p_idx = p_idx + 1
    }
    if page_data.txt.paragraphs.len() == 0 {
        echo(draw_row(["-", "(No paragraphs found)"], p_w))
    }
    echo(draw_divider(p_w))

    # Table 4: Images (img)
    print_category_header("IMAGES CATALOG (img)", page_data.img.len())
    let img_w = [4, 8, 8, 22, 32]
    echo(draw_divider(img_w))
    echo(draw_row(["#", "Format", "Dims", "Alt Text", "Image URL"], img_w))
    echo(draw_divider(img_w))
    let im_idx = 1
    for img in page_data.img {
        echo(draw_row([string(im_idx), img.format, img.dimensions, img.alt, img.url], img_w))
        im_idx = im_idx + 1
    }
    if page_data.img.len() == 0 {
        echo(draw_row(["-", "NONE", "-", "(No images found)", "-"], img_w))
    }
    echo(draw_divider(img_w))

    # Table 5: Videos & Multimedia (video)
    print_category_header("VIDEOS & MULTIMEDIA (video)", page_data.video.len())
    let vid_w = [4, 22, 50]
    echo(draw_divider(vid_w))
    echo(draw_row(["#", "Media Type", "Media Source / Stream URL"], vid_w))
    echo(draw_divider(vid_w))
    let v_idx = 1
    for v in page_data.video {
        echo(draw_row([string(v_idx), v.type, v.url], vid_w))
        v_idx = v_idx + 1
    }
    if page_data.video.len() == 0 {
        echo(draw_row(["-", "NONE", "(No video or multimedia streams detected)"], vid_w))
    }
    echo(draw_divider(vid_w))

    # Table 6: Downloadable Files (files)
    print_category_header("DOWNLOADABLE FILES & ARCHIVES (files)", page_data.files.len())
    let f_w = [4, 8, 28, 36]
    echo(draw_divider(f_w))
    echo(draw_row(["#", "Format", "Link Text", "File URL"], f_w))
    echo(draw_divider(f_w))
    let f_idx = 1
    for f in page_data.files {
        echo(draw_row([string(f_idx), f.format, f.label, f.url], f_w))
        f_idx = f_idx + 1
    }
    if page_data.files.len() == 0 {
        echo(draw_row(["-", "NONE", "(No downloadable files found)", "-"], f_w))
    }
    echo(draw_divider(f_w))

    # Table 7: Internal Links
    print_category_header("INTERNAL NAVIGATIONAL LINKS (links)", page_data.links.internal.len())
    let in_w = [4, 28, 44]
    echo(draw_divider(in_w))
    echo(draw_row(["#", "Anchor Label", "Destination URL"], in_w))
    echo(draw_divider(in_w))
    let in_idx = 1
    for lk in page_data.links.internal {
        echo(draw_row([string(in_idx), lk.label, lk.url], in_w))
        in_idx = in_idx + 1
    }
    if page_data.links.internal.len() == 0 {
        echo(draw_row(["-", "(None)", "(No internal links)"], in_w))
    }
    echo(draw_divider(in_w))

    # Table 8: External Links
    print_category_header("EXTERNAL OUTBOUND LINKS (links)", page_data.links.external.len())
    let ex_w = [4, 28, 44]
    echo(draw_divider(ex_w))
    echo(draw_row(["#", "Anchor Label", "External Destination"], ex_w))
    echo(draw_divider(ex_w))
    let ex_idx = 1
    for lk in page_data.links.external {
        echo(draw_row([string(ex_idx), lk.label, lk.url], ex_w))
        ex_idx = ex_idx + 1
    }
    if page_data.links.external.len() == 0 {
        echo(draw_row(["-", "(None)", "(No external links)"], ex_w))
    }
    echo(draw_divider(ex_w))

    # Table 9: HTML Tables
    if page_data.tables.len() > 0 {
        print_category_header("EXTRACTED HTML DATA TABLES (tables)", page_data.tables.len())
        for tbl in page_data.tables {
            echo("--- Table #" + string(tbl.index + 1) + " ---")
            if tbl.headers.len() > 0 {
